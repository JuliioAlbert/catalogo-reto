# Copia este archivo a .env y llena los valores solo en tu entorno.
# Nunca escribas aqui un token ni un id de cuenta reales.
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=5
MAX_QUESTION_CHARS=2000
PRODUCTS_PATH=data/products.json
SLO_P95_MS=2000
SERVICE_NAME=product-catalog

# Produccion: con ENVIRONMENT=production no arranca con MODEL_PROVIDER=fake,
# con API_KEYS vacia o con claves de menos de 16 caracteres.
ENVIRONMENT=development
# Formato cliente:clave,cliente2:clave2 (secreto; claves de 16 caracteres o mas).
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# Cloudflare AI Gateway (obligatorias con MODEL_PROVIDER=gateway)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Observabilidad
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Datos personales y respuestas
PII_MODE=redact
MAX_ANSWER_CHARS=2000
